# Qwen3.8-Flash-Next on GB10 using the released vLLM 0.29.0 stack.
#
# The source files are pinned to the upstream recipe commit below. They are
# fetched with checksums during the image build so dgxt owns the image tag and
# build workflow without copying a second recipe repository into this tree.
FROM vllm/vllm-openai:v0.29.0

LABEL qwen38.base=v0.29

ARG SP=/usr/local/lib/python3.12/dist-packages
ARG PKG=${SP}/vllm/models/qwen4_exp/nvidia
ARG PLE=${PKG}/ple_layer.py
ARG UPSTREAM=https://raw.githubusercontent.com/blazux/qwen3.8-Flash-DGX/c57881509af3dad83a28e59662fe3c4d29381628/src

ADD --checksum=sha256:b6c7ec60db0f3de602061c15d0892907b7536f2b6af0e3418131ce1742a5529d ${UPSTREAM}/vllm_ple_mmap.py ${SP}/vllm_ple_mmap.py
ADD --checksum=sha256:bcf59adbe3e317bc6300f6eecd01d2dcdb6388b7341449c74bdcee8c949b1f11 ${UPSTREAM}/patch_mamba_block_size.py /tmp/patch_mamba_block_size.py
ADD --checksum=sha256:802f6564e514fe5a228738873570f9ce94c230f40d3a7c932cc5893e2147a010 ${UPSTREAM}/patch_qsa_exact_topk.py /tmp/patch_qsa_exact_topk.py
ADD --checksum=sha256:4a3dfefa44666ac552046807430e47b0405d58e79a13da69cd1a297c230551b8 ${UPSTREAM}/vllm_fp8_hybrid_modelopt.py /tmp/vllm_fp8_hybrid_modelopt.py
ADD --checksum=sha256:209ddfba7ff2e6b434a4442b9b9176bd478d9d17ded94ff46a0c04a8ae42ed0e ${UPSTREAM}/patch_mtp_draft_vocab.py /tmp/patch_mtp_draft_vocab.py
ADD --checksum=sha256:6459e0fdc8df30e0c1d1f45be7c1b6bef0d68b0e73c073a82c52ea2a7f4b26d4 ${UPSTREAM}/draft_vocab_65536.npy /opt/llm/draft_vocab_65536.npy

# GB10 FLA resource/workgroup fixes from the same v0.29 recipe.
ARG FLA_UTILS=${SP}/vllm/third_party/flash_linear_attention/ops/utils.py
ARG FLA_CDH=${SP}/vllm/third_party/flash_linear_attention/ops/chunk_delta_h.py
RUN sed -i 's|DEFAULT = 102400|DEFAULT = 101376  # dgx-tools: GB10 shared-memory limit|' ${FLA_UTILS} \
 && sed -i 's|for num_warps in \[2, 4\]|for num_warps in [2]  # dgx-tools: Blackwell FLA stability|' ${FLA_CDH}

# Deterministic GB10 QSA top-k kernel, pinned to the upstream recipe commit.
ARG KDET=https://raw.githubusercontent.com/jschmied/qwen38-flash-next-gb10/e0ef69d4f5575dad00d34e05479eaf4c6547bace
ADD --checksum=sha256:138cacfc5eb117f0922d53c88727e4d0dc26dcfb246c3d401fc280cfc726cc71 ${KDET}/patches/kernel-det/build_det.py /opt/llm/kernel-det/src/build_det.py
ADD --checksum=sha256:b103fbeaf7589b9468471142ad0b30012a076f93d20ba11fc5ff6dcb1ecd32a6 ${KDET}/patches/kernel-det/bindings_det.cpp /opt/llm/kernel-det/src/bindings_det.cpp
ADD --checksum=sha256:19e1d53425ea9a839445722fd1dac1c41727128eebdce84508c1bfb8592afecf ${KDET}/patches/kernel-det/topk_det.cu /opt/llm/kernel-det/src/topk_det.cu
ADD --checksum=sha256:16939700ae389750782ff5c0d5b9caef59aa0ff8b869b64ec94fa72c814910ee ${KDET}/patches/kernel-det/torch_utils.h /opt/llm/kernel-det/src/torch_utils.h
ADD --checksum=sha256:b4ef9ce298d43d6c0e6db9fcca451df20815b2cfe33791919c1ad9c0e84f0ba7 ${KDET}/patches/kernel-det/persistent_topk.cuh /opt/llm/kernel-det/src/persistent_topk.cuh
ADD --checksum=sha256:70905073fe3fa361030bf1cb469b74610766bdfe361419cd7df50af2561322e3 ${KDET}/tools/determinism/qsadet_patch.py /tmp/qsadet_patch.py

RUN mkdir -p /opt/llm/kernel-det/build \
 && cd /opt/llm/kernel-det/src \
 && DET_BUILD_DIR=/opt/llm/kernel-det/build DET_ARCH=121a python3 build_det.py 2>&1 | tail -2 \
 && cp /opt/llm/kernel-det/build/_C_det.so /opt/llm/kernel-det/_C_det.so \
 && VLLM_QSA_PY=${PKG}/ops/qsa.py python3 /tmp/qsadet_patch.py \
 && rm /tmp/qsadet_patch.py

# v0.29 names the PLE class and source layout differently from the preview
# image. The runtime hook is inert unless VLLM_PLE_MMAP=1 is set.
RUN cp ${PLE} ${PLE}.orig \
 && printf '\n\n# --- dgx-tools: serve the PLE n-gram table from disk ---\nfrom vllm_ple_mmap import apply as _ple_mmap_apply\n_ple_mmap_apply(Qwen4ExpNGramEmbedding)\n' >> ${PLE} \
 && python3 -c "import ast; ast.parse(open('${PLE}').read()); print('ple_layer.py patched OK')" \
 && python3 /tmp/patch_mamba_block_size.py ${SP} \
 && python3 /tmp/patch_qsa_exact_topk.py ${PKG}/ops/qsa.py \
 && cp /tmp/vllm_fp8_hybrid_modelopt.py ${SP}/vllm_fp8_hybrid_modelopt.py \
 && cp ${SP}/vllm/model_executor/layers/quantization/modelopt.py ${SP}/vllm/model_executor/layers/quantization/modelopt.py.orig \
 && printf '\n\n# --- dgx-tools: optional NVFP4 + blockwise-FP8 hybrid mode ---\nfrom vllm_fp8_hybrid_modelopt import apply as _fp8_hybrid_apply\n_fp8_hybrid_apply()\n' >> ${SP}/vllm/model_executor/layers/quantization/modelopt.py \
 && python3 /tmp/patch_mtp_draft_vocab.py ${PKG}/mtp.py \
 && python3 - <<'PY'
import ast
from pathlib import Path
for path in (
    Path("/usr/local/lib/python3.12/dist-packages/vllm_ple_mmap.py"),
    Path("/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/quantization/modelopt.py"),
):
    ast.parse(path.read_text())
print("v0.29 Flash-Next patches validated")
PY
