#!/usr/bin/env bash
# dgxt — bootstrap and run LLM inference engines in Docker on a DGX
# Spark-class box (single GPU node, NVIDIA container toolkit installed).
#
# dgxt's only job is getting a model serving as fast as possible. It does
# NOT wrap or duplicate the HuggingFace `hf` CLI — for browsing, searching,
# downloading, or inspecting the model cache, use `hf` directly (dgxt offers
# to install it via pip if it's missing, but never does so silently). See:
#   https://huggingface.co/docs/huggingface_hub/en/guides/cli
#
# Engines are pluggable (lib/engines/*.sh). Currently implemented: vLLM,
# NIM. Placeholders exist for TensorRT-LLM, SGLang, and Ollama — select
# one with `dgxt engine <name>` once it's implemented.
#
# Quick start:
#   dgxt setup                              Guided: pick engine, prereqs, hf auth, pick a model, start
#   dgxt start [model] [--max-context N|Nk|Nm]    Start the current engine's container
#
# Commands:
#   start [model] [--max-context N|Nk|Nm]    Start the container (e.g. 65536, 64k, 1m)
#   stop                               Stop and remove the container
#   restart [model] [--max-context N|Nk|Nm]  Stop then start
#   logs                               Tail container logs
#   status                             Show container state
#   config                             Show effective configuration
#   save                                Save current effective settings to ~/.dgxtrc
#                                       (also creates the file if it doesn't exist yet)
#   engine [name]                      Show/list engines, or switch the active one
#   search [query]                     Passthrough to `hf models ls --search ...` (HF-based engines only)
#   model-pull [model]                 Passthrough to `hf download` (HF-based engines only)
#   model-list                         Passthrough to `hf cache ls`
#   setup                              Guided setup (engine pick, prereqs, hf auth, model pick, start)
#   help                               Show this help
#
# Config file: ~/.dgxtrc (key=value, loaded automatically if present)
#   DGXT_ENGINE=vllm
#   VLLM_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
#   VLLM_MAX_MODEL_LEN=1m
#   VLLM_API_KEY=<random, generated by save/setup/start>
#   VLLM_PORT=8000
#   VLLM_GPU_MEM=0.85
#   VLLM_SPECULATIVE_MODE=dspark|none|mtp|dflash
#   VLLM_SPECULATIVE_MODEL=<optional draft/speculator model>
#   VLLM_SPECULATIVE_TOKENS=3
#   HF_TOKEN=hf_...
#   # NIM engine instead uses: NIM_IMAGE, NGC_API_KEY, NIM_PORT (see lib/engines/nim.sh)
#
# Env vars always override the config file (export VLLM_MODEL=... etc).
#
# Not reimplemented here — use `hf` directly:
#   Browse/search models:   hf models ls --search <query> --apps vllm --sort downloads
#   Pre-download a model:   hf download <model>
#   List cached models:     hf cache ls
#   Log in / check auth:    hf auth login / hf auth whoami
#   Pre-pull an image:      docker pull vllm/vllm-openai:latest
#
# LAN access: http://<this-ip>:<port>/v1/chat/completions
# --- end help ---
set -euo pipefail

# Resolve the repository root through a PATH symlink (e.g.
# ~/.local/bin/dgxt) before loading the sibling lib/ directory.
DGXT_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=../lib/common.sh
source "$DGXT_ROOT/lib/common.sh"

load_config "$DEFAULT_CONFIG_FILE"

# ---- Engine selection ------------------------------------------------

list_engine_files() {
  for f in "$DGXT_ROOT"/lib/engines/*.sh; do
    basename "$f" .sh
  done
}

# Source the given engine's module, defining ENGINE_* vars/functions for
# the rest of this script to use.
load_engine() {
  local name="$1"
  local file="$DGXT_ROOT/lib/engines/${name}.sh"
  if [[ ! -f "$file" ]]; then
    echo "ERROR: Unknown engine '$name'. Available engines:" >&2
    list_engine_files | sed 's/^/  /' >&2
    exit 1
  fi
  # Safe defaults so `${!ENGINE_MODEL_VAR}`-style indirection never hits
  # "invalid indirect expansion"/"invalid variable name" for a placeholder
  # engine that hasn't defined these name-mappings yet (an empty string
  # doesn't work as an indirection target either — must be a real,
  # always-unset identifier). Real engines override these below.
  ENGINE_MODEL_VAR="_DGXT_UNSET" ENGINE_MAX_LEN_VAR="_DGXT_UNSET"
  ENGINE_API_KEY_VAR="_DGXT_UNSET" ENGINE_PORT_VAR="_DGXT_UNSET"
  ENGINE_GPU_MEM_VAR="_DGXT_UNSET" ENGINE_TOOL_CALL_PARSER_VAR="_DGXT_UNSET"
  ENGINE_REASONING_PARSER_VAR="_DGXT_UNSET"
  ENGINE_DEFAULT_MODEL=""
  ENGINE_DEFAULT_TOOL_CALL_PARSER=""
  ENGINE_DEFAULT_REASONING_PARSER=""
  # ENGINE_API_KEY_EXTERNAL=1 means this engine's API key must come from an
  # external service (e.g. NIM's NGC_API_KEY) and should never be
  # auto-generated; ENGINE_API_KEY_HINT is the guidance shown when it's unset.
  ENGINE_API_KEY_EXTERNAL="0"
  ENGINE_API_KEY_HINT=""
  # Whether this engine can actually extend a model past its native
  # context via RoPE scaling (see cmd_start's native-max-context check) --
  # only vLLM supports this today. Engines that can't (e.g. NIM, whose
  # precompiled DGX-Spark engines have no such knob) get an honest "this
  # won't really work" note instead of a silent no-op bypass.
  ENGINE_SUPPORTS_ROPE_SCALING="0"
  # shellcheck source=/dev/null
  source "$file"
}

CURRENT_ENGINE="${DGXT_ENGINE:-vllm}"
load_engine "$CURRENT_ENGINE"

# Warn about (and offer to stop) any OTHER engine's container that's still
# running. dgxt treats "current engine" as the one active server, but
# nothing stops a container from a PREVIOUSLY active engine from still
# running under its own name — which then fights the new one for the same
# port (and GPU memory). Left unhandled, that surfaces as a cryptic
# "port is already allocated" docker error instead of a clear cause.
check_other_engines_running() {
  local name other_container
  for name in $(list_engine_files); do
    [[ "$name" == "$CURRENT_ENGINE" ]] && continue
    other_container=$(source "$DGXT_ROOT/lib/engines/${name}.sh" 2>/dev/null; echo "${ENGINE_CONTAINER_NAME:-}")
    [[ -z "$other_container" ]] && continue
    if is_running "$other_container"; then
      echo "WARNING: the '$name' engine's container ('$other_container') is still running."
      echo "  Running two engines at once will likely conflict on port 8000 and/or GPU memory."
      read -rp "  Stop it now? [Y/n] " stop_other
      if [[ ! "$stop_other" =~ ^[Nn] ]]; then
        cmd_stop "$other_container"
      else
        echo "  Leaving it running — you may hit a port conflict below."
      fi
      echo ""
    fi
  done
}

cmd_engine() {
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    echo "Current engine: $CURRENT_ENGINE"
    echo ""
    echo "Available engines:"
    local name status
    for name in $(list_engine_files); do
      status="planned"
      (source "$DGXT_ROOT/lib/engines/${name}.sh"; [[ "$ENGINE_STATUS" == "ready" ]]) 2>/dev/null && status="ready"
      printf "  %-14s %s%s\n" "$name" "$status" "$([[ "$name" == "$CURRENT_ENGINE" ]] && echo '  (active)')"
    done
    echo ""
    echo "Switch with: dgxt engine <name>"
    return 0
  fi

  local file="$DGXT_ROOT/lib/engines/${target}.sh"
  if [[ ! -f "$file" ]]; then
    echo "ERROR: Unknown engine '$target'. Run 'dgxt engine' to list available engines." >&2
    return 1
  fi
  save_config_value DGXT_ENGINE "$target"
  echo "Active engine set to: $target"
  ( source "$file"
    if [[ "${ENGINE_STATUS:-planned}" != "ready" ]]; then
      echo "NOTE: '$target' is a placeholder — not implemented yet. 'dgxt start' will fail until it is."
    fi
  )
}

# ---- Core commands (generic; delegate engine-specific pieces) -----------

cmd_start() {
  if [[ "${ENGINE_STATUS:-planned}" != "ready" ]]; then
    echo "ERROR: '$CURRENT_ENGINE' is a placeholder — not implemented yet." >&2
    echo "See lib/engines/vllm.sh for the reference pattern, or run 'dgxt engine' to pick a ready engine." >&2
    return 1
  fi

  ensure_docker

  if is_running "$ENGINE_CONTAINER_NAME"; then
    echo "Container '$ENGINE_CONTAINER_NAME' is already running."
    return
  fi

  check_other_engines_running

  # A previous failed `docker run` (e.g. a port conflict) can leave behind
  # a stopped/never-started container with this name, which then makes
  # THIS run fail with "Conflict: name already in use" instead of actually
  # retrying. Safe to remove unconditionally here: the is_running check
  # above already confirmed it's not currently serving anything.
  docker rm -f "$ENGINE_CONTAINER_NAME" >/dev/null 2>&1 || true

  # Parse args: model name, then --max-context [N|Nk|Nm]
  local model="${!ENGINE_MODEL_VAR:-$ENGINE_DEFAULT_MODEL}"
  local max_len=""
  local max_len_explicit=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --max-context)
        if [[ -n "${2:-}" && "$2" != --* ]]; then
          max_len=$(parse_context_size "$2")
          max_len_explicit=1
          shift 2
        else
          max_len="auto"
          shift
        fi
        ;;
      *)
        model="$1"
        shift
        ;;
    esac
  done

  local max_len_var_val
  max_len_var_val=$(parse_context_size "${!ENGINE_MAX_LEN_VAR:-}")
  if [[ -z "$max_len" ]]; then
    if [[ -n "$max_len_var_val" ]]; then
      max_len="$max_len_var_val"
      max_len_explicit=1
    else
      max_len=$(resolve_default_context "$model")
    fi
  elif [[ "$max_len" == "auto" ]]; then
    max_len=$(resolve_default_context "$model")
  fi

  # If the context length was explicitly requested (CLI flag or a
  # persisted config value) rather than auto-resolved, warn before
  # wasting a full container-startup cycle if it exceeds the model's
  # actual native max. vLLM (and likely other engines) hard-reject this
  # deep in container logs after a slow model load anyway, with a real
  # risk of "incorrect output or CUDA errors" if bypassed blindly --
  # this is the same check vLLM's own validator enforces, just surfaced
  # immediately instead of after a wasted startup attempt. Only fires
  # when resolve_max_context can derive a real native value for this
  # model (empty means "unknown" — e.g. an unmapped NIM image — and is
  # deliberately not warned about, since there's nothing to compare
  # against).
  if [[ "$max_len_explicit" == "1" && "$max_len" =~ ^[0-9]+$ ]]; then
    local native_max
    native_max=$(resolve_max_context "$model")
    if [[ "$native_max" =~ ^[0-9]+$ ]] && (( max_len > native_max )); then
      echo "WARNING: requested context ($max_len) exceeds $model's native max ($native_max)."
      echo "  Exceeding it risks incorrect output or CUDA errors."
      read -rp "  Continue anyway? [y/N] " confirm_ctx
      if [[ ! "$confirm_ctx" =~ ^[Yy] ]]; then
        echo "Aborted. Try: dgxt start --max-context $native_max"
        return 1
      fi
      ALLOW_LONG_MAX_MODEL_LEN=1
      if [[ "${ENGINE_SUPPORTS_ROPE_SCALING:-0}" == "1" ]]; then
        # Genuinely extend context via YaRN RoPE scaling rather than just
        # disabling the safety check — without this, tokens past
        # native_max are out-of-distribution and produce degraded output
        # regardless of the bypass above. Factor/original_max here use
        # the model's own reported native max as the scaling base, which
        # is a reasonable machine-discoverable default but may not match
        # a model author's specifically-validated value (e.g. Qwen's own
        # docs recommend 32768 as the YaRN base for Qwen3 dense models,
        # not their extended config.json default of 40960) — override
        # with VLLM_ROPE_SCALING_FACTOR/VLLM_ROPE_SCALING_ORIGINAL_MAX if
        # you know a better value for this specific model.
        ROPE_SCALING_ORIGINAL_MAX="$native_max"
        ROPE_SCALING_FACTOR=$(awk -v m="$max_len" -v n="$native_max" 'BEGIN { f = m / n; printf (f == int(f)) ? "%d" : "%.2f", f }')
        echo "  Applying YaRN RoPE scaling: factor=${ROPE_SCALING_FACTOR}, original_max=${native_max}."
        echo "  (override via VLLM_ROPE_SCALING_FACTOR / VLLM_ROPE_SCALING_ORIGINAL_MAX if you know"
        echo "  a better-validated value for this model)"
      else
        echo "  NOTE: '$CURRENT_ENGINE' has no RoPE-scaling override available through dgxt —"
        echo "  this bypass only disables a safety check, it does NOT actually extend usable"
        echo "  context. For NIM specifically, a precompiled hardware-optimized engine's context"
        echo "  is baked in at NVIDIA's build time and literally cannot be changed at all,"
        echo "  regardless of this setting. Switch to vLLM ('dgxt engine vllm') for genuine"
        echo "  context extension via YaRN."
      fi
    fi
  fi

  local port="${!ENGINE_PORT_VAR:-8000}"
  local gpu_mem=""
  if engine_defines_var "$ENGINE_GPU_MEM_VAR"; then
    gpu_mem=$(resolve_gpu_memory_for_engine "$model")
  fi
  local tool_call_parser="${!ENGINE_TOOL_CALL_PARSER_VAR:-$(resolve_tool_call_parser_for_engine "$model")}"
  local reasoning_parser="${!ENGINE_REASONING_PARSER_VAR:-$(resolve_reasoning_parser_for_engine "$model")}"
  local api_key api_key_was_unset=0
  if [[ "${ENGINE_API_KEY_EXTERNAL:-0}" == "1" ]]; then
    # This engine's "API key" comes from an external service (not
    # something dgxt can safely auto-generate, e.g. NIM's NGC_API_KEY) —
    # generating a random fallback here would silently persist a bogus
    # credential and fail confusingly later. Require it explicitly.
    api_key="${!ENGINE_API_KEY_VAR:-}"
    if [[ -z "$api_key" ]]; then
      echo "ERROR: $ENGINE_API_KEY_VAR is not set." >&2
      echo "  ${ENGINE_API_KEY_HINT:-Set it in $DEFAULT_CONFIG_FILE or export it, then retry.}" >&2
      return 1
    fi
  else
    api_key=$(resolve_api_key "$ENGINE_API_KEY_VAR")
    [[ -z "${!ENGINE_API_KEY_VAR:-}" ]] && api_key_was_unset=1
  fi

  echo ""
  echo "Starting $ENGINE_NAME server:"
  echo "  Config file:    $DEFAULT_CONFIG_FILE $([ -f "$DEFAULT_CONFIG_FILE" ] && echo '(loaded)' || echo '(not found)')"
  echo "  Model:          $model"
  engine_defines_var "$ENGINE_MAX_LEN_VAR" && echo "  Context:        ${max_len:-auto (engine default)}${max_len:+ tokens}"
  engine_defines_var "$ENGINE_GPU_MEM_VAR" && echo "  GPU memory:     ${gpu_mem} (fraction)"
  echo "  Port:           $port"
  echo "  API key:        ${api_key:0:8}..."
  engine_defines_var "$ENGINE_TOOL_CALL_PARSER_VAR" && echo "  Tool calling:   ${tool_call_parser:-disabled}"
  engine_defines_var "$ENGINE_REASONING_PARSER_VAR" && echo "  Reasoning:      ${reasoning_parser:-disabled}"
  echo "  Image:          ${ENGINE_IMAGE:-n/a}"
  echo ""
  if [[ "$api_key_was_unset" -eq 1 ]]; then
    # Persist immediately — otherwise a later `dgxt save`/`setup`/`start`
    # would independently generate a *different* random key, permanently
    # diverging from whatever this container is actually running with.
    save_config_value "$ENGINE_API_KEY_VAR" "$api_key"
    echo "NOTE: No $ENGINE_API_KEY_VAR configured — generated and saved a new key to $DEFAULT_CONFIG_FILE."
    echo ""
  fi

  if [[ -n "${ENGINE_HF_APPS_FILTER:-}" && -z "${HF_TOKEN:-}" ]]; then
    echo "WARNING: HF_TOKEN not set. Gated models may fail to download."
    echo "  Log in with: hf auth login   (or set HF_TOKEN / add it to $DEFAULT_CONFIG_FILE)"
    read -rp "  Continue anyway? [y/N] " confirm
    if [[ ! "$confirm" =~ ^[Yy] ]]; then
      echo "Aborted."
      return 1
    fi
  fi

  # Create the cache dir as the current user before Docker's bind mount
  # would otherwise auto-create it as root, which would block future
  # non-container downloads (e.g. `hf download`, `dgxt model-pull`).
  ensure_hub_cache || return 1

  echo "Starting container..."
  engine_run_container "$model" "$max_len" "$port" "$gpu_mem" "$api_key" "$tool_call_parser" "$reasoning_parser"

  echo "Container started. Watching logs for model download/loading..."
  echo ""
  wait_for_ready "$ENGINE_CONTAINER_NAME" "$port"
}

cmd_restart() {
  cmd_stop "$ENGINE_CONTAINER_NAME"
  cmd_start "$@"
}

cmd_config() {
  echo "=== Active dgxt Configuration ==="
  echo ""
  echo "Config file: $DEFAULT_CONFIG_FILE $([ -f "$DEFAULT_CONFIG_FILE" ] && echo '(exists)' || echo '(not found)')"
  [[ -f "$DEFAULT_CONFIG_FILE" ]] && echo "" && cat "$DEFAULT_CONFIG_FILE"
  echo ""
  echo "--- Effective values (env > config > defaults) ---"
  printf "  %-20s %s\n" "DGXT_ENGINE:" "$CURRENT_ENGINE"
  if [[ "${ENGINE_STATUS:-planned}" != "ready" ]]; then
    echo "  ('$CURRENT_ENGINE' is a placeholder — no engine-specific settings yet)"
  else
    local cfg_model="${!ENGINE_MODEL_VAR:-$ENGINE_DEFAULT_MODEL}"
    printf "  %-20s %s\n" "$ENGINE_MODEL_VAR:" "$cfg_model"
    if engine_defines_var "$ENGINE_MAX_LEN_VAR"; then
      local cfg_max_len
      cfg_max_len=$(parse_context_size "${!ENGINE_MAX_LEN_VAR:-}")
      cfg_max_len="${cfg_max_len:-$(resolve_default_context "$cfg_model")}"
      printf "  %-20s %s\n" "$ENGINE_MAX_LEN_VAR:" "${cfg_max_len:-<unset; engine default applies>}"
    fi
    if [[ "${ENGINE_API_KEY_EXTERNAL:-0}" == "1" ]]; then
      printf "  %-20s %s\n" "$ENGINE_API_KEY_VAR:" "${!ENGINE_API_KEY_VAR:-<not set; ${ENGINE_API_KEY_HINT:-required, see engine docs}>}"
    else
      printf "  %-20s %s\n" "$ENGINE_API_KEY_VAR:" "${!ENGINE_API_KEY_VAR:-<not set; a random key is generated at start>}"
    fi
    printf "  %-20s %s\n" "$ENGINE_PORT_VAR:" "${!ENGINE_PORT_VAR:-8000}"
    if engine_defines_var "$ENGINE_GPU_MEM_VAR"; then
      printf "  %-20s %s\n" "$ENGINE_GPU_MEM_VAR:" "$(resolve_gpu_memory_for_engine "$cfg_model")"
    fi
    if engine_defines_var "$ENGINE_TOOL_CALL_PARSER_VAR"; then
      local cfg_tool_call_parser="${!ENGINE_TOOL_CALL_PARSER_VAR:-$(resolve_tool_call_parser_for_engine "${!ENGINE_MODEL_VAR:-$ENGINE_DEFAULT_MODEL}")}"
      printf "  %-20s %s\n" "$ENGINE_TOOL_CALL_PARSER_VAR:" "${cfg_tool_call_parser:-disabled}"
    fi
    if engine_defines_var "$ENGINE_REASONING_PARSER_VAR"; then
      local cfg_reasoning_parser="${!ENGINE_REASONING_PARSER_VAR:-$(resolve_reasoning_parser_for_engine "${!ENGINE_MODEL_VAR:-$ENGINE_DEFAULT_MODEL}")}"
      printf "  %-20s %s\n" "$ENGINE_REASONING_PARSER_VAR:" "${cfg_reasoning_parser:-disabled}"
    fi
  fi
  printf "  %-20s %s\n" "HF_TOKEN:" "${HF_TOKEN:-(not set)}"
  printf "  %-20s %s\n" "HUB_CACHE:" "$HUB_CACHE"
  echo ""
  echo "Container:"
  if is_running "$ENGINE_CONTAINER_NAME"; then
    echo "  Status: running"
    docker ps --filter "name=^${ENGINE_CONTAINER_NAME}$" --format "  Ports: {{.Ports}}"
  else
    echo "  Status: stopped"
  fi
}

# Save current effective settings (env > config > defaults) to ~/.dgxtrc.
# Works whether or not the file already exists yet, so this doubles as the
# "generate a default config" command too — just run it with no env vars
# set for a fresh, all-defaults file.
cmd_save() {
  if [[ "${ENGINE_STATUS:-planned}" != "ready" ]]; then
    echo "ERROR: '$CURRENT_ENGINE' is a placeholder — no engine-specific settings to save yet." >&2
    echo "Run 'dgxt engine <name>' to switch to a ready engine first." >&2
    return 1
  fi

  local model="${!ENGINE_MODEL_VAR:-$ENGINE_DEFAULT_MODEL}"
  local max_len=""
  if engine_defines_var "$ENGINE_MAX_LEN_VAR"; then
    max_len=$(parse_context_size "${!ENGINE_MAX_LEN_VAR:-}")
    max_len="${max_len:-$(resolve_default_context "$model")}"
  fi
  local api_key=""
  if [[ "${ENGINE_API_KEY_EXTERNAL:-0}" == "1" ]]; then
    api_key="${!ENGINE_API_KEY_VAR:-}"
  else
    api_key=$(resolve_api_key "$ENGINE_API_KEY_VAR")
  fi
  local port="${!ENGINE_PORT_VAR:-8000}"
  local gpu_mem=""
  engine_defines_var "$ENGINE_GPU_MEM_VAR" && gpu_mem=$(resolve_gpu_memory_for_engine "$model")
  local tool_call_parser=""
  engine_defines_var "$ENGINE_TOOL_CALL_PARSER_VAR" && tool_call_parser="${!ENGINE_TOOL_CALL_PARSER_VAR:-$(resolve_tool_call_parser_for_engine "$model")}"
  local reasoning_parser=""
  engine_defines_var "$ENGINE_REASONING_PARSER_VAR" && reasoning_parser="${!ENGINE_REASONING_PARSER_VAR:-$(resolve_reasoning_parser_for_engine "$model")}"
  local hf_token="${HF_TOKEN:-}"

  {
    echo "# dgx-tools config file"
    echo "# Edit this file or set env vars to override"
    echo "# Env vars take priority over this file"
    echo ""
    echo "# Active engine (vllm, tensorrt-llm, sglang, llama-cpp, nim, ollama)"
    echo "DGXT_ENGINE=$CURRENT_ENGINE"
    echo ""
    echo "# Model to serve"
    echo "$ENGINE_MODEL_VAR=$model"
    echo ""
    if engine_defines_var "$ENGINE_MAX_LEN_VAR"; then
      echo "# Max context length in tokens (auto-resolved per model if unset)"
      echo "$ENGINE_MAX_LEN_VAR=$max_len"
      echo ""
    fi
    if [[ -n "$api_key" ]]; then
      echo "# API key for the server endpoint"
      echo "$ENGINE_API_KEY_VAR=$api_key"
    else
      echo "# ${ENGINE_API_KEY_HINT:-API key for the server endpoint}"
      echo "# $ENGINE_API_KEY_VAR=..."
    fi
    echo ""
    echo "# Port to expose (container always uses 8000 internally)"
    echo "$ENGINE_PORT_VAR=$port"
    echo ""
    if engine_defines_var "$ENGINE_GPU_MEM_VAR"; then
      echo "# GPU memory fraction (0.0-1.0)"
      echo "$ENGINE_GPU_MEM_VAR=$gpu_mem"
      echo ""
    fi
    if engine_defines_var "$ENGINE_TOOL_CALL_PARSER_VAR"; then
      echo "# Tool-call parser for agentic/function-calling clients (empty disables"
      echo "# tool calling support entirely). Must match the model's tool-call output"
      echo "# format: https://docs.vllm.ai/en/latest/features/tool_calling.html"
      echo "$ENGINE_TOOL_CALL_PARSER_VAR=$tool_call_parser"
      echo ""
    fi
    if engine_defines_var "$ENGINE_REASONING_PARSER_VAR"; then
      echo "# Reasoning/chain-of-thought parser (empty disables --enable-reasoning"
      echo "# entirely). Must match the model's reasoning output format:"
      echo "# https://docs.vllm.ai/en/latest/features/reasoning_outputs.html"
      echo "$ENGINE_REASONING_PARSER_VAR=$reasoning_parser"
      echo ""
    fi
    echo "# HuggingFace token for gated models (or just run: hf auth login)"
    if [[ -n "$hf_token" ]]; then
      echo "HF_TOKEN=$hf_token"
    else
      echo "# HF_TOKEN=hf_..."
    fi
    echo ""
    echo "# To add this to your shell profile (~/.bashrc or ~/.zshrc):"
    echo "#   [ -f ~/.dgxtrc ] && source ~/.dgxtrc"
  } > "$DEFAULT_CONFIG_FILE"

  echo "Saved to $DEFAULT_CONFIG_FILE:"
  echo "  DGXT_ENGINE=$CURRENT_ENGINE"
  echo "  $ENGINE_MODEL_VAR=$model"
  engine_defines_var "$ENGINE_MAX_LEN_VAR" && echo "  $ENGINE_MAX_LEN_VAR=$max_len"
  [[ -n "$api_key" ]] && echo "  $ENGINE_API_KEY_VAR=$api_key"
  echo "  $ENGINE_PORT_VAR=$port"
  engine_defines_var "$ENGINE_GPU_MEM_VAR" && echo "  $ENGINE_GPU_MEM_VAR=$gpu_mem"
  engine_defines_var "$ENGINE_TOOL_CALL_PARSER_VAR" && echo "  $ENGINE_TOOL_CALL_PARSER_VAR=$tool_call_parser"
  engine_defines_var "$ENGINE_REASONING_PARSER_VAR" && echo "  $ENGINE_REASONING_PARSER_VAR=$reasoning_parser"
  [[ -n "$hf_token" ]] && echo "  HF_TOKEN=$hf_token"
}

cmd_help() {
  awk '
    NR==1 { next }
    /^# --- end help ---/ { exit }
    /^#/ { sub(/^# ?/, ""); print }
  ' "$0"
}

# Guided setup: pick an engine, check prerequisites, configure HF auth,
# suggest a model, start.
cmd_setup() {
  echo "=== dgxt Setup ==="
  echo ""

  echo "[1/5] Engine selection..."
  echo "  Current: $CURRENT_ENGINE"
  echo ""
  echo "  Available engines:"
  local name status
  for name in $(list_engine_files); do
    status="planned"
    (source "$DGXT_ROOT/lib/engines/${name}.sh"; [[ "$ENGINE_STATUS" == "ready" ]]) 2>/dev/null && status="ready"
    printf "    %-14s %s\n" "$name" "$status"
  done
  echo ""
  read -rp "  Engine to use (enter to keep '$CURRENT_ENGINE'): " engine_input
  if [[ -n "$engine_input" && "$engine_input" != "$CURRENT_ENGINE" ]]; then
    if [[ ! -f "$DGXT_ROOT/lib/engines/${engine_input}.sh" ]]; then
      echo "  Unknown engine '$engine_input'; keeping '$CURRENT_ENGINE'."
    else
      CURRENT_ENGINE="$engine_input"
      load_engine "$CURRENT_ENGINE"
      save_config_value DGXT_ENGINE "$CURRENT_ENGINE"
      echo "  Switched to: $CURRENT_ENGINE"
    fi
  fi
  if [[ "${ENGINE_STATUS:-planned}" != "ready" ]]; then
    echo "  '$CURRENT_ENGINE' isn't implemented yet — setup can't continue for it."
    return 1
  fi
  echo ""

  echo "[2/5] Checking Docker..."
  if ! docker ps >/dev/null 2>&1; then
    echo "  Docker not accessible (not in docker group?)."
    echo "  Run this in your terminal:"
    echo "    sudo usermod -aG docker \$USER && newgrp docker"
    echo ""
    read -rp "  Done? [y/N] " done_docker
    if [[ ! "$done_docker" =~ ^[Yy] ]]; then
      echo "Please run the command above and try again."
      exit 1
    fi
    ensure_docker
  fi
  echo "  Docker OK"
  echo ""

  echo "[3/5] HuggingFace CLI & authentication..."
  if [[ -z "${ENGINE_HF_APPS_FILTER:-}" ]]; then
    echo "  Not used by '$CURRENT_ENGINE' — skipping."
  else
    if ! ensure_hf_cli; then
      exit 1
    fi
    if hf auth whoami >/dev/null 2>&1; then
      echo "  Already authenticated with hf."
    else
      echo "  Not logged in. A token is required for gated models (Llama, etc.)."
      echo "  Get one at: https://huggingface.co/settings/tokens"
      echo ""
      read -rp "  Log in now with 'hf auth login'? [Y/n] " do_login
      if [[ ! "$do_login" =~ ^[Nn] ]]; then
        hf auth login || true
      else
        echo "  Skipping — you can run 'hf auth login' any time."
      fi
    fi
    # Mirror hf's stored token into HF_TOKEN for the container: the
    # container has its own environment, not hf's local credential store.
    local hf_token
    hf_token=$(hf auth token 2>/dev/null || true)
    if [[ -n "$hf_token" ]]; then
      save_config_value HF_TOKEN "$hf_token"
      echo "  HF_TOKEN saved to $DEFAULT_CONFIG_FILE for the container to use."
    fi
  fi
  echo ""

  echo "[4/5] API key..."
  # ENGINE_API_KEY_VAR is already in the environment here if it was in the
  # config file — load_config() exported it at script startup.
  local api_key="${!ENGINE_API_KEY_VAR:-}"
  if [[ -n "$api_key" ]]; then
    echo "  $ENGINE_API_KEY_VAR is set: ${api_key:0:8}..."
  elif [[ "${ENGINE_API_KEY_EXTERNAL:-0}" == "1" ]]; then
    echo "  $ENGINE_API_KEY_VAR is not set."
    echo "  ${ENGINE_API_KEY_HINT:-This engine requires a key from an external service.}"
    read -rp "  Paste $ENGINE_API_KEY_VAR now (or leave blank to skip): " api_key
    if [[ -n "$api_key" ]]; then
      save_config_value "$ENGINE_API_KEY_VAR" "$api_key"
      echo "  Saved."
    else
      echo "  Skipping — 'dgxt start' will fail until $ENGINE_API_KEY_VAR is set."
    fi
  else
    api_key=$(resolve_api_key "$ENGINE_API_KEY_VAR")
    save_config_value "$ENGINE_API_KEY_VAR" "$api_key"
    echo "  Generated and saved: ${api_key:0:8}..."
  fi
  echo ""

  echo "[5/5] Model selection..."
  local model="${!ENGINE_MODEL_VAR:-$ENGINE_DEFAULT_MODEL}"
  echo "  Current default: $model"
  echo ""

  # Build a single numbered picker: already-downloaded models first (ready
  # to serve right now, no wait), then the hardcoded recommendations that
  # aren't already downloaded. picks[N] maps a menu number to a model id.
  local -a picks=()
  local cached_list cached_line cid csize entry mid size note already_listed

  cached_list=$(list_cached_models)
  if [[ -n "$cached_list" ]]; then
    echo "  Already downloaded (ready to serve now):"
    while IFS='|' read -r cid csize; do
      [[ -z "$cid" ]] && continue
      picks+=("$cid")
      printf "    %2d) %-46s %s\n" "${#picks[@]}" "$cid" "$csize"
    done <<< "$cached_list"
    echo ""
  fi

  echo "  Recommended models for this box:"
  for entry in "${ENGINE_RECOMMENDED_MODELS[@]}"; do
    IFS='|' read -r mid size note <<< "$entry"
    already_listed="0"
    for cid in "${picks[@]}"; do
      [[ "$cid" == "$mid" ]] && already_listed="1" && break
    done
    [[ "$already_listed" == "1" ]] && continue
    picks+=("$mid")
    printf "    %2d) %-46s %-8s %s\n" "${#picks[@]}" "$mid" "$size" "$note"
  done
  echo ""
  if [[ -n "${ENGINE_HF_APPS_FILTER:-}" ]]; then
    echo "  Browse more: hf models ls --search <query> --apps $ENGINE_NAME --sort downloads"
    echo ""
  fi
  read -rp "  Model to serve (number above, a HF model id, or enter to use default): " model_input
  if [[ -n "$model_input" ]]; then
    if [[ "$model_input" =~ ^[0-9]+$ && "$model_input" -ge 1 && "$model_input" -le "${#picks[@]}" ]]; then
      model="${picks[$((model_input - 1))]}"
    else
      model="$model_input"
    fi
  fi
  save_config_value "$ENGINE_MODEL_VAR" "$model"

  echo ""
  echo "Starting $ENGINE_NAME..."
  echo ""
  cmd_start "$model"
}

# ---- Main --------------------------------------------------------

case "${1:-help}" in
  start)      shift; cmd_start "$@" ;;
  stop)       cmd_stop "$ENGINE_CONTAINER_NAME" ;;
  restart)    shift; cmd_restart "$@" ;;
  logs)       cmd_logs "$ENGINE_CONTAINER_NAME" ;;
  status)     cmd_status "$ENGINE_CONTAINER_NAME" ;;
  config)     cmd_config ;;
  save)       cmd_save ;;
  engine)     shift; cmd_engine "$@" ;;
  setup)      cmd_setup ;;
  search)     shift; cmd_search "$@" ;;
  model-pull) shift; cmd_model_pull "$@" ;;
  model-list) shift; cmd_model_list "$@" ;;
  help|--help|-h) cmd_help ;;
  *)          cmd_help; exit 1 ;;
esac
